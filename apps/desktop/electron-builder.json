{
  "appId": "ai.careerpilot.desktop",
  "productName": "CareerPilot AI",
  "directories": {
    "output": "release"
  },
  "files": ["dist/**/*", "electron/**/*"],
  "extraResources": [
    {
      "from": "../../backend",
      "to": "backend",
      "filter": ["app/**/*", "migrations/**/*", "pyproject.toml", "alembic.ini"]
    }
  ],
  "win": {
    "target": "nsis"
  },
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": ["AppImage", "deb"]
  }
}
